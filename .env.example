# Configuración de la API (prefijo CHESS_).
CHESS_APP_NAME=Chess Accessibility API
CHESS_API_PREFIX=/api/v1
CHESS_MAX_IMAGE_BYTES=10485760
CHESS_STORAGE_BACKEND=memory
CHESS_LOG_LEVEL=INFO

# PostgreSQL (para cuando storage_backend=postgres).
CHESS_DATABASE_URL=postgresql://chess:chess@postgres:5432/chess

# Frontend (Vite).
VITE_API_BASE=http://localhost:8000/api/v1
